# Copy this file to .env.local and change the passcode.
# Restart the dev server after editing — env files are read at startup.
#
# NOTE: anything prefixed NEXT_PUBLIC_ is bundled into the client build and is
# readable by anyone who opens the site. This gate keeps casual visitors out of
# /admin; it is NOT authentication. Do not deploy /admin publicly until the
# server-side auth work lands.

NEXT_PUBLIC_ADMIN_EMAIL=you@example.com
NEXT_PUBLIC_ADMIN_PASSCODE=pick-your-own-passcode

# --- Optional: analytics (cookieless, nothing is recorded until set) ---
# NEXT_PUBLIC_ANALYTICS_PROVIDER=plausible
# NEXT_PUBLIC_ANALYTICS_DOMAIN=example.com
# NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=
# NEXT_PUBLIC_ANALYTICS_SRC=
# NEXT_PUBLIC_ANALYTICS_SHARE_URL=

# --- Optional: the site's public URL, used for canonical + Open Graph links ---
# Detected from the host when deployed; set it for local production builds.
# OPB_SITE_URL=https://example.com
