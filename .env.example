# Copy this file to .env.local and change the passcode.
# Restart the dev server after editing — Vite only reads env files at startup.
#
# NOTE: anything prefixed VITE_ is bundled into the client build and is
# readable by anyone who opens the site. This gate keeps casual visitors out
# of /admin; it is not real authentication. Do not deploy /admin publicly
# until the hosted backend with proper auth is in place.

VITE_ADMIN_EMAIL=you@example.com
VITE_ADMIN_PASSCODE=pick-your-own-passcode
